<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="custom_payroll_ke_hr_contract_view_form" model="ir.ui.view">
            <field name="name">custom.payroll.ke.hr.contract.view.form</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name = 'hr_responsible_id']" position="before">
                    <field name="tax_applicable"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>