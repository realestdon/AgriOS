<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="cash_allowances_type_view_action"
                model="ir.actions.act_window">
            <field name="name">Types of Cash Allowances</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cash.allowances.type</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Create New Cash Allowances
                </p>
            </field>
        </record>
         <menuitem id="menu_cash_allowances_type"
                  parent="om_hr_payroll.menu_hr_payroll_configuration"
                  name="Cash Allowances" sequence="101"
                  action="cash_allowances_type_view_action"
                  groups="hr.group_hr_manager"/>
        <!-- Cash Allowances Type Form view-->
        <record id="cash_allowances_type_form_view" model="ir.ui.view">
            <field name="name">cash.allowances.type.form.view</field>
            <field name="model">cash.allowances.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="id" invisible="True"/>
                        <group name="allowances_type" string="Cash Allowances">
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="rule_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- Cash Allowances Type List view-->
        <record id="cash_allowances_type_list_view" model="ir.ui.view">
            <field name="name">cash.allowances.type.list.view</field>
            <field name="model">cash.allowances.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="rule_id"/>
                </list>
            </field>
        </record>
    </data>
</odoo>