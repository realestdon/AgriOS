<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="custom_payroll_base_hr_salary_rule_form" model="ir.ui.view">
            <field name="name">custom.payroll.base.hr.salary.rule.form</field>
            <field name="model">hr.salary.rule</field>
            <field name="inherit_id" ref="om_hr_payroll.hr_salary_rule_form"/>
            <field name="arch" type="xml">

                <xpath expr="//page[@name='rules']" position="after">
                    <page name="structures" string="Structures">
                        <field name="structure_ids"/>
                    </page>
                </xpath>

            </field>
        </record>
    </data>
</odoo>