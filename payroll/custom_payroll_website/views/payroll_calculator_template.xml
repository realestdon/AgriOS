<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--  Google Fonts — must be a <link> tag, not CSS @import, due to Odoo asset bundling  -->
<template id="paye_calculator_assets" inherit_id="website.layout" name="PAYE Calculator Fonts">
<xpath expr="//head" position="inside">
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;family=DM+Mono:wght@400;500&amp;display=swap"/>
</xpath>
</template>
<template id="paye_calculator_page" name="PAYE Calculator">
<t t-call="website.layout">
<div class="paye_page_wrapper">
<!--  ═══════════════════════════════════════
                     HERO
                ═══════════════════════════════════════  -->
<section class="paye_hero">
<div class="container">
<div class="row align-items-center">
<div class="col-lg-7 paye_hero_inner">
<div class="paye_hero_badge">
<svg viewBox="0 0 24 24">
<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
</svg>
Powered by your Odoo Salary Structure
</div>
<h1>
Payroll
<em>PAYE Calculator</em>
</h1>
<p>
Select your country, enter your gross salary and click
<strong>Compute</strong>
— your company's exact salary rules will calculate the net pay instantly.
</p>
</div>
<div class="col-lg-5 paye_hero_graphic">
<div class="hero_donut_wrap">
<svg viewBox="0 0 200 200" width="220" height="220">
<circle cx="100" cy="100" r="90" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="18"/>
<circle class="hero_seg_net" cx="100" cy="100" r="90" fill="none" stroke="#f5a623" stroke-width="18" stroke-linecap="round" stroke-dasharray="565 0" stroke-dashoffset="0"/>
</svg>
<div class="donut_center_text">
<span class="dc_label">Take Home</span>
<span class="dc_value hero_net_pct">—</span>
<span class="hero_net_val" style="font-size:11px;color:rgba(255,255,255,0.45);margin-top:2px;">Enter salary</span>
</div>
</div>
</div>
</div>
</div>
</section>
<!--  ═══════════════════════════════════════
                     CALCULATOR
                ═══════════════════════════════════════  -->
<section class="paye_calculator_section">
<div class="container">
<div class="row g-4">
<!--  ── LEFT: INPUTS ───────────────────────  -->
<div class="col-lg-5">
<div class="calc_input_card">
<h3>Salary Details</h3>
<!--  Country selector — populated from DB  -->
<div class="mb-4">
<span class="field_label">Country</span>
<div class="country_tabs" id="country_tabs">
<!--  JS replaces this with live countries from /paye/countries  -->
<div class="paye_skeleton_tabs">
<span class="skeleton_tab">Loading…</span>
</div>
</div>
</div>
<!--  Structure selector — populated per country  -->
<div class="mb-4 structure_selector_wrap" style="display:none;">
<span class="field_label">Salary Structure</span>
<select class="form-select structure_select"/>
</div>
<!--  Gross Salary input  -->
<div class="salary_field_wrap mb-4">
<span class="field_label">Monthly Gross Salary</span>
<div class="salary_input_group">
<span class="salary_currency">KES</span>
<input type="number" class="salary_input" value="" min="0" max="2000000" step="1000" placeholder="e.g. 50,000"/>
</div>
<div class="range_wrap mt-3">
<div class="range_labels">
<span>0</span>
<span>500K</span>
<span>1M</span>
</div>
<input type="range" class="salary_slider" min="0" max="1000000" step="1000" value="0"/>
</div>
</div>
<!--  Employee Options  -->
<div class="employee_options_wrap">
<div class="options_row">
<div class="option_field">
<span class="field_label">Is Resident?</span>
<div class="yes_no_select">
<button class="yn_btn active" data-field="is_resident" data-value="yes">Yes</button>
<button class="yn_btn" data-field="is_resident" data-value="no">No</button>
</div>
</div>
<div class="option_field">
<span class="field_label">Secondary Employee?</span>
<div class="yes_no_select">
<button class="yn_btn active" data-field="is_secondary" data-value="no">No</button>
<button class="yn_btn" data-field="is_secondary" data-value="yes">Yes</button>
</div>
</div>
</div>
<div class="deductions_title">Statutory Deductions</div>
<div class="deduction_toggle_row">
<div class="deduction_info">
<span class="deduction_name">Deduct NSSF</span>
</div>
<label class="toggle_switch">
<input type="checkbox" class="deduct_toggle" data-deduct="deductNSSF" checked="1"/>
<span class="toggle_track"/>
</label>
</div>
<div class="deduction_toggle_row">
<div class="deduction_info">
<span class="deduction_name">Deduct PAYE</span>
</div>
<label class="toggle_switch">
<input type="checkbox" class="deduct_toggle" data-deduct="deductPAYE" checked="1"/>
<span class="toggle_track"/>
</label>
</div>
<div class="deduction_toggle_row">
<div class="deduction_info">
<span class="deduction_name">Deduct Housing Levy</span>
</div>
<label class="toggle_switch">
<input type="checkbox" class="deduct_toggle" data-deduct="deductHousing" checked="1"/>
<span class="toggle_track"/>
</label>
</div>
<div class="deduction_toggle_row">
<div class="deduction_info">
<span class="deduction_name">Deduct NHIF / SHIF</span>
</div>
<label class="toggle_switch">
<input type="checkbox" class="deduct_toggle" data-deduct="deductNHIF" checked="1"/>
<span class="toggle_track"/>
</label>
</div>
</div>
<!--  Compute button  -->
<button class="btn_compute" id="btn_compute" disabled="disabled">
<span class="btn_compute_text">
<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
<path d="M9 7H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-3"/>
<path d="M9 15h3l8.5-8.5a1.5 1.5 0 0 0-3-3L9 12v3"/>
<path d="M16 5l3 3"/>
</svg>
Compute Net Salary
</span>
<span class="btn_compute_loading" style="display:none;">
<span class="paye_spinner"/>
Calculating…
</span>
</button>
<!--  Error message area  -->
<div class="compute_error" style="display:none;"/>
<!--  Structure source badge  -->
<div class="structure_source_badge mt-3" style="display:none;"/>
</div>
</div>
<!--  ── RIGHT: RESULTS ─────────────────────  -->
<div class="col-lg-7">
<div class="calc_results_card">
<!--  Empty state — shown before first compute  -->
<div class="results_empty_state">
<div class="empty_icon">
<svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
<rect x="2" y="3" width="20" height="14" rx="2"/>
<path d="M8 21h8M12 17v4"/>
<path d="M7 8h4M7 11h2"/>
<path d="M15 8l2 2-2 2"/>
</svg>
</div>
<p>
Enter a gross salary and click
<strong>Compute</strong>
to see the full payroll breakdown using your company's salary structure.
</p>
</div>
<!--  Results — hidden until first compute  -->
<div class="results_content" style="display:none;">
<!--  Header  -->
<div class="results_header">
<h3>Monthly Gross Salary</h3>
<div class="gross_salary_display">
<span class="curr curr_label">KES</span>

<span class="amount">0</span>
</div>
</div>
<!--  Donut chart  -->
<div class="results_chart_wrap">
<div style="position:relative;width:160px;height:160px;">
<svg class="results_donut_svg" viewBox="0 0 160 160" width="160" height="160">
<circle cx="80" cy="80" r="60" fill="none" stroke="#f0f4f5" stroke-width="22"/>
<circle id="seg_net" cx="80" cy="80" r="60" fill="none" stroke="#1a7a8a" stroke-width="22" stroke-linecap="butt" stroke-dasharray="377 0" stroke-dashoffset="0"/>
<circle id="seg_paye" cx="80" cy="80" r="60" fill="none" stroke="#ef4444" stroke-width="22" stroke-linecap="butt" stroke-dasharray="0 377" stroke-dashoffset="0"/>
<circle id="seg_nssf" cx="80" cy="80" r="60" fill="none" stroke="#f5a623" stroke-width="22" stroke-linecap="butt" stroke-dasharray="0 377" stroke-dashoffset="0"/>
<circle id="seg_nhif" cx="80" cy="80" r="60" fill="none" stroke="#22c55e" stroke-width="22" stroke-linecap="butt" stroke-dasharray="0 377" stroke-dashoffset="0"/>
<circle id="seg_other" cx="80" cy="80" r="60" fill="none" stroke="#a855f7" stroke-width="22" stroke-linecap="butt" stroke-dasharray="0 377" stroke-dashoffset="0"/>
</svg>
<div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;">
<span style="font-size:11px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">Net Pay</span>
<span class="donut_net_pct" style="font-size:24px;font-weight:800;color:var(--text-main);font-family:var(--font-mono);">0%</span>
</div>
</div>
</div>
<!--  Dynamic breakdown rows — rendered by JS  -->
<div class="results_breakdown">
<!--  JS injects breakdown_item rows here  -->
</div>
<!--  Net Pay box  -->
<div class="net_pay_box">
<div class="net_pay_label">Monthly Net Pay (Take Home)</div>
<div class="net_pay_amount">
<span class="curr">KES</span>
<span class="net_val">0</span>
</div>
<div class="net_pay_monthly_note">After all salary structure deductions</div>
</div>
</div>
<!--  /.results_content  -->
</div>
<!--  /.calc_results_card  -->
</div>
</div>
<!--  /.row  -->
</div>
<!--  /.container  -->
</section>
<!--  ═══════════════════════════════════════
                     INFO SECTION
                ═══════════════════════════════════════  -->
<section class="paye_info_section">
<div class="container">
<div class="row align-items-center mb-4">
<div class="col-lg-8">
<h2 style="font-size:2rem;font-weight:800;color:var(--text-main);letter-spacing:-0.02em;">How PAYE is Calculated in Kenya</h2>
<p style="color:var(--text-muted);font-size:16px;line-height:1.7;margin-top:12px;">PAYE is deducted by employers from employees' salaries at source and remitted to KRA by the 9th of the following month.</p>
</div>
</div>
<div class="info_grid">
<div class="info_card">
<div class="info_card_icon">
<svg viewBox="0 0 24 24">
<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
</svg>
</div>
<h4>NSSF — National Social Security Fund</h4>
<p>Tiered contributions under the 2023 NSSF Act. Employee and employer each contribute 6%, capped at KES 2,160/month.</p>
</div>
<div class="info_card">
<div class="info_card_icon">
<svg viewBox="0 0 24 24">
<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
</svg>
</div>
<h4>NHIF / SHIF</h4>
<p>Income-based slab contributions ranging from KES 150 to KES 1,700 per month depending on gross salary.</p>
</div>
<div class="info_card">
<div class="info_card_icon">
<svg viewBox="0 0 24 24">
<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
<polyline points="9 22 9 12 15 12 15 22"/>
</svg>
</div>
<h4>Affordable Housing Levy</h4>
<p>Both employee and employer each contribute 1.5% of gross monthly salary towards the Government's affordable housing programme.</p>
</div>
<div class="info_card">
<div class="info_card_icon">
<svg viewBox="0 0 24 24">
<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
<line x1="8" y1="21" x2="16" y2="21"/>
<line x1="12" y1="17" x2="12" y2="21"/>
</svg>
</div>
<h4>Personal Tax Relief</h4>
<p>Every Kenyan taxpayer gets a personal relief of KES 2,400/month (KES 28,800/year), deducted directly from computed PAYE.</p>
</div>
</div>
<div class="tax_bands_wrap">
<h3>2024 KRA PAYE Tax Bands (Monthly)</h3>
<div class="table-responsive">
<table class="tax_band_table">
<thead>
<tr>
<th>Band</th>
<th>Monthly Income (KES)</th>
<th>Annual Income (KES)</th>
<th>Rate</th>
</tr>
</thead>
<tbody>
<tr>
<td>Band 1</td>
<td>0 – 24,000</td>
<td>0 – 288,000</td>
<td>
<span class="rate_badge rate_10">10%</span>
</td>
</tr>
<tr>
<td>Band 2</td>
<td>24,001 – 32,333</td>
<td>288,001 – 388,000</td>
<td>
<span class="rate_badge rate_25">25%</span>
</td>
</tr>
<tr>
<td>Band 3</td>
<td>32,334 – 500,000</td>
<td>388,001 – 6,000,000</td>
<td>
<span class="rate_badge rate_30">30%</span>
</td>
</tr>
<tr>
<td>Band 4</td>
<td>500,001 – 800,000</td>
<td>6,000,001 – 9,600,000</td>
<td>
<span class="rate_badge rate_32">32.5%</span>
</td>
</tr>
<tr>
<td>Band 5</td>
<td>Above 800,000</td>
<td>Above 9,600,000</td>
<td>
<span class="rate_badge rate_35">35%</span>
</td>
</tr>
</tbody>
</table>
</div>
<p style="font-size:13px;color:var(--text-muted);margin-top:12px;">* Personal relief of KES 2,400/month deducted after computing gross tax. Source: KRA.</p>
</div>
</div>
</section>
<!--  ═══════════════════════════════════════
                     CTA
                ═══════════════════════════════════════  -->
<section class="paye_cta_section">
<div class="container">
<div class="paye_cta_inner">
<h2>Automate Your Payroll in Odoo</h2>
<p>Let Odoo handle PAYE, NSSF, NHIF and Housing Levy automatically — for every employee, every month, with zero errors.</p>
<a href="/contactus" class="cta_btn_primary">Request a Demo</a>
</div>
</div>
</section>
</div>
<!--  /.paye_page_wrapper  -->
</t>
</template>
</odoo>